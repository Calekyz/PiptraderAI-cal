# ============================================================================
# PipTraderAI — Environment Variables
# ----------------------------------------------------------------------------
# Copy this to `.env` and fill in real values.
# On Render: set these in the dashboard → Environment tab.
# ============================================================================

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://www.piptraderai.com
ADMIN_PASSWORD=                    # Required for admin destructive actions

# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Preferred: full connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Legacy fallback (only used if DATABASE_URL is unset)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# ── Runtime file storage ─────────────────────────────────────────────────
# Where the server writes telegram-state.json, briefing-state.json, etc.
# On Render use /tmp (or a mounted disk path)
PAYMENTS_DATA_DIR=/tmp

# ── AI providers ─────────────────────────────────────────────────────────
GEMINI_API_KEY=                    # Required: verifier, Nova, briefings
DEEPSEEK_API_KEY=                  # Required: Nova chat replies

# ── Market data ──────────────────────────────────────────────────────────
TWELVE_DATA_API_KEY=               # Live quotes (free tier: 800/day)
USE_TWELVE_FOR_CANDLES=false       # Set true to use TwelveData for candles too

# ── News feed ────────────────────────────────────────────────────────────
NEWSDATA_API_KEY=                  # Live news (free tier: 200/day)

# ── Telegram: signals ────────────────────────────────────────────────────
TELEGRAM_SIGNAL_BOT_TOKEN=         # Bot that posts signals
TELEGRAM_SIGNAL_GROUPS=@peshyFx    # Comma-separated channel list
TELEGRAM_CHANNEL_ID=@peshyFx       # Fallback if SIGNAL_GROUPS unset
TELEGRAM_DEDUPE_MINUTES=240        # Suppress same symbol+direction+TF for N min
TELEGRAM_SIGNAL_TTL_MINUTES=60     # Auto-delete signal after N min (0 = never)

# ── Telegram: briefings ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                # Bot that posts briefings
TELEGRAM_BRIEFING_CHANNEL_ID=@calekyz
TELEGRAM_SIGNALS_ENABLED=true      # Set false to disable signal broadcast

# ── Payments: PaywaveXpress ──────────────────────────────────────────────
PAYWAVEXPRESS_API_KEY=
PAYWAVEXPRESS_BASE_URL=
PAYWAVEXPRESS_EMAIL=

# ── Payments: M-Pesa ─────────────────────────────────────────────────────
MPESA_CALLBACK_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=sandbox         # sandbox | production
MPESA_BUSINESS_NAME=
MPESA_ACCOUNT_NAME=

# ── Payments: PayHero (legacy) ───────────────────────────────────────────
PAYHERO_BASE_URL=
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
PAYHERO_PROVIDER=
PAYHERO_NETWORK_CODE=
PAYHERO_CALLBACK_URL=
PAYHERO_BASIC_AUTH=

# ── Payments: Binance (crypto) ───────────────────────────────────────────
BINANCE_WALLET_ADDRESS=
BINANCE_WALLET_PROVIDER=
BINANCE_NETWORK=
BINANCE_MIN_DEPOSIT=
BINANCE_ID=

# ── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PipTraderAI <no-reply@piptraderai.com>"
SMTP_SECURE=false

# ── Currency ─────────────────────────────────────────────────────────────
USD_TO_KES_RATE=130
USD_KES_RATE=130

# ── Database connection pool ─────────────────────────────────────────────
DB_POOL_SIZE=10

# ── Bot Bridge (external bot platform → PipTraderAI) ──────────────────────
# Shared secret used by the external bot platform to POST signals/data into
# the platform. Endpoint + payload schema TBD (see project backlog).
BRIDGE_TOKEN=
